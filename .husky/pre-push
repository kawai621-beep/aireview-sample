# PR前セルフレビューのゲート（ツール非依存: Claude Code / Codex / CLI すべてで動作）
# push するコミットのセルフレビュー結果を検証する。
set -e

sha="$(git rev-parse HEAD 2>/dev/null || echo "")"
result=".self-review/${sha}.json"

# 意図的にスキップしたい場合は環境変数 SKIP_SELF_REVIEW=1
if [ "${SKIP_SELF_REVIEW:-0}" = "1" ]; then
  echo "[pre-push] SKIP_SELF_REVIEW=1 のためセルフレビューゲートをスキップします。"
  exit 0
fi

if [ -z "$sha" ] || [ ! -f "$result" ]; then
  echo "[pre-push] セルフレビュー結果が見つかりません（.self-review/${sha}.json）。"
  echo "  PR前セルフレビューを実行してください:"
  echo "    - Claude Code: /self-review"
  echo "    - その他: docs/pr-self-review-checklist.md に沿ってレビューし .self-review/<sha>.json を生成"
  exit 1
fi

status="$(jq -r '.status // ""' "$result" 2>/dev/null || echo "")"
if [ "$status" != "pass" ]; then
  echo "[pre-push] セルフレビューのステータスが「${status}」です。パスしていません。"
  jq -r '.findings[]? | "  - [\(.severity)] \(.file):\(.line) \(.issue)"' "$result" 2>/dev/null || true
  echo "問題を修正して再度セルフレビューを実行してください。"
  exit 1
fi

echo "[pre-push] セルフレビュー合格（commit ${sha:0:8}）。push を許可します。"
exit 0
